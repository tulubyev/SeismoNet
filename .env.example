# ─── SeismoNet — переменные окружения ───────────────────────────────────────
# Скопировать в .env (dev) или в .env на VPS (prod). .env в git не попадает.

# База данных (обязательно). Единственная БД проекта — seismonet_db на VPS.
#   dev  (Mac, через SSH-туннель `npm run tunnel start`):
DATABASE_URL=postgres://tulubyev:CHANGE_ME@localhost:5433/seismonet_db
#   prod (Docker-контейнер на VPS, системный PostgreSQL 16 на хосте):
# DATABASE_URL=postgres://tulubyev:CHANGE_ME@172.28.0.1:5432/seismonet_db
# Приоритетнее DATABASE_URL, если задан (историческое имя):
# VPS_DATABASE_URL=

# Сессии: `openssl rand -hex 32`. Обязателен в production — сервер не стартует без него.
SESSION_SECRET=CHANGE_ME

# Сервер
NODE_ENV=development
PORT=5000
# dev only: which DB user POST /api/dev-login logs in as (default admin)
# DEV_LOGIN_USERNAME=admin

# Уведомления (опционально)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
UNISENDER_API_KEY=

# Прочее (опционально)
# Сколько версий заметки к расчёту хранить (по умолчанию 50)
# NOTE_HISTORY_LIMIT=50

# ─── Зарезервировано: код пока НЕ читает эти ключи ─────────────────────────
# TELEGRAM_WEBHOOK_SECRET=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# SMTP_HOST= / SMTP_PORT= / SMTP_USER= / SMTP_PASSWORD= / SMTP_FROM=
# SMSRU_API_ID=
# TOGETHER_API_KEY= / TOGETHER_MODEL=
# CDN_URL= / VITE_CDN_URL=
# S3_ACCESS_KEY= / S3_SECRET_KEY= / S3_BUCKET= / S3_ENDPOINT= / S3_REGION=
